# Text files normalized to LF line endings (avoids autocrlf conversion warnings)
* text=auto
*.v text eol=lf
*.md text eol=lf
*.sh text eol=lf
Makefile text eol=lf
*.ml text eol=lf
*.json text eol=lf
# Binary build artifacts (trust cache bodies, tracked in the repository)
*.vo binary
*.vos binary
*.vok binary
*.glob binary
